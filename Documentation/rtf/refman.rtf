\pard\plain \s2\sb240\sa60\keepn\widctlpar\adjustright \b\f1\fs28\kerning28\cgrid 
SPI Send\par \pard\plain 
{\tc\tcl2 \v SPI Send}
{\xe \v SPI Send}
{\bkmkstart AAAAAAAVXX}
{\bkmkend AAAAAAAVXX}
{
\pard\plain \s17\sa60\sb30\widctlpar\qj \fs22\cgrid {\s17\sa60\sb30\widctlpar\qj \fs22\cgrid 
SPI protocol communication instruction. This instruction sends data or an array to an SPI device and gets a response, which is saved in the provided variable.\par
 SPI protocol supports multiple slaves. To make this function work properly, make sure that the devices support a tri-state configuration when they are disabled.\par
 No more than one device should be on the bus at the same time.\par
 If you need to send several bytes (more than 16bit) to the device you target without changing the chip select signal, put the bytes you have (it doesn't matter how many) in an array and make the communication 8bits. This will allow the spi_send command to send the bytes one by one using only one chip select cycling (high-low- high). This is applicable ONLY when you have a numerical array. But, Text array will be treated differently, and data will be sent byte by byte with chip select cycling per each byte.\par
{\i {\pard\plain \s4\sb240\sa60\keepn\widctlpar\adjustright \b\f1\fs20\cgrid {\tc\tcl4 Syntax: } \par}
} \par
{\i }  {\b  spi_send }  DEVICE_ID, WaitForReply(returned bytes), SPI_DATA (could be an array using a variable), DATASIZE/TYPE =8/12/16, FREQ, SPI_MOD =0/1/2/3 Default=0 , VARIABLE_NAME, DELAY BETWEEN PACKETS(Optional)\par
 {
\par
\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid -DEVICE_ID:                 SPI address/Device ID - Decoder from 1 to 15. 0 is reserved {\cf19 for} SD-Card\par
-waitForReply:              Do the slave reply back any value?\par
-SpiData:                   Data to be sent to the slave. (could be an array {\cf17 using }a variable)\par
-spiDataSize  DataSize:     Data size or type. DATASIZE/TYPE =8/12/16\par
-spi_frequency:             SPI channel frequency. Typical =1000000\par
-spi_mode:                  SPI Mode: SPI_MOD =0/1/2/3 Default=0\par
-Variable_Name:             Variable will be used to save the reply.\par
-Delay:                     Delay necessary between packets (Optional)\par
}
 {\i {\b  Example:} }  \par
 MESSAGE="ABCDEFGHIJKLMNOPQRSTUVXYZ"\par
  REM DEVICE_ID, WaitForReply, SPI_DATA, DATASIZE/TYPE =8/12/16, FREQ, SPI_MOD =0/1/2/3 Default=0 , VARIABLE_NAME, DELAY between packets(optional)\par
 spi_send 1,26,MESSAGE,8,5000000,0,myvar,10000;\par
{\i {\b  Complex Example:} }  \par
 Let say that we need to write and read from an external Flash memory for ex. (AT25512N-SH). The following code is using mbed and C++. {
\par
\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid {\cf21 #include "mbed.h"}\par
SPI device(SPI_MOSI, SPI_MISO, SPI_SCK);\par
\par
DigitalOut CS(SPI_CS);\par
\par
Serial pc(USBTX, USBRX);\par
\par
{\cf18 int} {\field {\*\fldinst { HYPERLINK  \\l "AAAAAAAMIL" }{}}{\fldrslt {\cs37\ul\cf2 main}}}
()\par
\{\par
    pc.printf({\cf22 "MEM Write Started\\n"});\par
   device.format(8, 0);\par
   device.frequency(1000000);\par
    {\cf18 int} v;\par
        {\cf19 for}({\cf18 int} i=0x200; i<0x0210;i++)\{\par
            CS=1;\par
            CS=0;\par
            wait_ms(1);\par
           device.write(0x01);\par
           device.write(0x00);\par
            CS=1;\par
            CS=0;\par
           device.write(0x6);\par
            CS=1;\par
            CS=0;\par
           device.write(0x02);\par
            v=slave.write((i&0xff00)>>8);\par
            v=slave.write(i&0xff);\par
           device.write((0xDA));\par
            CS=1;\par
            pc.printf({\cf22 "Address= %x %x\\n"},((i&0xff00)>>8), (i&0xff));\par
        \}\par
    pc.printf({\cf22 "MEM Read Started\\n"});\par
\par
    CS=1;\par
    \{\par
        {\cf19 for}({\cf18 int} i=0x200; i<0x210;i++) \{\par
            wait_ms(1);\par
            CS=0;\par
           device.write(0x03);\par
           device.write((i&0xff00)>>8);\par
           device.write(i&0xff);\par
            v=slave.write(0);\par
            CS=1;\par
            pc.printf({\cf22 "Results for i=%i : %x\\n"},i,v);\par
        \}\par
    \}\par
\}\par
}
 Now the equivalent script code is as follow : {
\par
\pard\plain \s40\li0\widctlpar\adjustright \shading1000\cbpat8 \f2\fs16\cgrid enable_debug\par
function write(adres)\{\par
    REM send write enable.\par
    spi_send 1,0,0x0100,0x16,1000000,0,Reply,0\par
\par
    REM send enable write\par
    spi_send 1,0,0x06,0x8,1000000,0,Reply,0\par
\par
    REM send data\par
    spi_send 1,0,adres,0x8,1000000,0,Reply,0\par
\par
\}\par
\par
\par
function read(av )\{\par
    REM Read request\par
    Address[]=\{0x03,0,0,0\};\par
    Address[1]=av\par
    spi_send 1,1,Address,0x8,1000000,0,Reply,0\par
    print Reply\par
\}\par
\par
\par
\par
for(i=0x200, i<0x210, i++)\{\par
 writeAdr[]=\{0x02,0,0,0xDA\}\par
 writeAdr[1]=(i&0xff00);\par
 writeAdr[1]=writeAdr[1]>>8;\par
 writeAdr[1]=(i&0x00ff);;\par
 call write(writeAdr)\par
\}\par
\par
while(1)\par
\{\par
 for(i=0x200, i<0x210, i++)\{\par
  print "i="\par
  print i\par
  call read(i)\par
  print "\\n"\par
  \}\par
\}\par
}
 \par
}}
