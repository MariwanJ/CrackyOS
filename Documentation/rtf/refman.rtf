\pard\plain \s120\fi-360\li360\widctlpar\jclisttab\tx360{\*\pn \pnlvlbody\ilvl0\ls1\pnrnot0\pndec }\ls1\adjustright \fs20\cgrid 
Return value: result is 0 when the data fails to transmit.\par
 {\i {\pard\plain \s4\sb240\sa60\keepn\widctlpar\adjustright \b\f1\fs20\cgrid {\tc\tcl4 Syntax: } \par}
} \par}
\par
{\i }  {\b  can_send PinName1, PinName2,ResultVariable ,FREQ, CANID, CAND_DATA0,...CAN_DATA7;} \par
{
\par
\pard\plain \s120\fi-360\li360\widctlpar\jclisttab\tx360{\*\pn \pnlvlbody\ilvl0\ls1\pnrnot0\pndec }\ls1\adjustright \fs20\cgrid 
{\b PinName1:}  CANRD pin name\par
\pard\plain \s120\fi-360\li360\widctlpar\jclisttab\tx360{\*\pn \pnlvlbody\ilvl0\ls1\pnrnot0\pndec }\ls1\adjustright \fs20\cgrid 
{\b PinName2:}  CANTD pin name\par
\pard\plain \s120\fi-360\li360\widctlpar\jclisttab\tx360{\*\pn \pnlvlbody\ilvl0\ls1\pnrnot0\pndec }\ls1\adjustright \fs20\cgrid 
{\b ResultVariable:}  Result Variable.\par
\pard\plain \s120\fi-360\li360\widctlpar\jclisttab\tx360{\*\pn \pnlvlbody\ilvl0\ls1\pnrnot0\pndec }\ls1\adjustright \fs20\cgrid 
{\b FREQ \~\~\~\~\~ :}  CAN Bus frequency\par
\pard\plain \s120\fi-360\li360\widctlpar\jclisttab\tx360{\*\pn \pnlvlbody\ilvl0\ls1\pnrnot0\pndec }\ls1\adjustright \fs20\cgrid 
{\b CANID \~\~\~\~ :}  CAN ID. This represents the CAN device ID\par
\pard\plain \s120\fi-360\li360\widctlpar\jclisttab\tx360{\*\pn \pnlvlbody\ilvl0\ls1\pnrnot0\pndec }\ls1\adjustright \fs20\cgrid 
{\b VARIABLE_NAME/CAN_DATA0 ...CAN_DATA7:}  You must provide the instruction with a variable name or CAN DATA (At least one byte or up to 8 bytes).\par}
\par
{\i {\b  Example:}  }  \par
 while(1)\par
 \~\{\par
 \~can_send pb_8, pb_9,result,100000,0x10,0xdd, 0xaa;\par
 \~if(result==1)\{\par
 \~ exit;\par
 \} \~\par
delay 500,Msec;\par
 \}\par
 \par
}}
