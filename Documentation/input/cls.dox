* <span style='color:blue'><em><B> <br>
Example:
</B> </em> </span><br>
*   cls;	  						&nbsp;&nbsp;&nbsp;  <span style='color:green'> rem clear the terminal</span><br>
*	print "Hello World\n";	&nbsp;&nbsp;&nbsp;  <span style='color:green'> rem send to the terminal 'Hello World\\n'</span>
*
*
*/
