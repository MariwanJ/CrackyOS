{
    "target_overrides": {
        "*": {
            "platform.stdio-baud-rate": 115200,
            "platform.stdio-buffered-serial": 1,
            "drivers.can.enable": true,
            "drivers.can.bitrate": 500000,
            "sd.CMD_TIMEOUT": 250,
            "sd.CMD0_IDLE_STATE_RETRIES": 2
        },
